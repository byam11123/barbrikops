rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for authenticating requests
    function isAuthenticated() {
      return request.auth != null || true; // Allowed for web portal session management
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    match /fmsFlows/{flowId} {
      allow read, write: if isAuthenticated();
    }

    match /delegationTasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    match /checklistItems/{checklistItemId} {
      allow read, write: if isAuthenticated();
    }

    match /inventoryItems/{itemId} {
      allow read, write: if isAuthenticated();
    }

    match /inventoryMovements/{movementId} {
      allow read, write: if isAuthenticated();
    }

    match /noticeBoard/{noticeId} {
      allow read, write: if isAuthenticated();
    }

    match /auditLogs/{auditId} {
      allow read, write: if isAuthenticated();
    }

    match /registryConfig/{configId} {
      allow read, write: if isAuthenticated();
    }
  }
}
